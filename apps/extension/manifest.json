{
  "manifest_version": 3,
  "name": "TRASCO - AI Cyber Guardian",
  "version": "1.0.0",
  "description": "Pelindung siber cerdas berbasis AI untuk mendeteksi penipuan online, phishing, dan modus transfer palsu.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://trasco.oscspace.online/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "TRASCO Cyber Guardian"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
