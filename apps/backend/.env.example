# Copy this file to .env and set SECRET_KEY before starting the backend.
PROJECT_NAME="TRASCO API"
API_V1_STR="/api/v1"
DEBUG=True

# Security & JWT
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Use a separate local database; do not point this at a database containing user data.
DATABASE_URL="sqlite:///./trasco_local.db"

# Optional Google Gemini API key. Image analysis fails closed without it.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_TIMEOUT_SECONDS=15.0

# Allowed CORS Origins
CORS_ORIGINS=["*"]
